# ---- shared ----
# Postgres
DATABASE_URL=postgres://kqa:kqa_password@localhost:5432/kqa

# Milvus
MILVUS_ADDRESS=localhost:19530

# Redis（SSE 事件总线 pub/sub + 文档处理队列）
REDIS_URL=redis://localhost:6379

# MinIO（业务文档使用独立私有 bucket）
MINIO_ENDPOINT=http://localhost:9000
MINIO_REGION=us-east-1
MINIO_BUCKET=kqa-documents
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Auth —— JWT 签名密钥，auth 与 web 两个 app 必须一致
AUTH_SECRET=change-me-to-a-long-random-string
# cookie 共享的父域名（本地开发用 lvh.me，生产换成 .your-domain.com）
COOKIE_DOMAIN=.lvh.me
# auth app 的对外地址（未登录时重定向到这里）
AUTH_APP_URL=http://auth.lvh.me:3001
# web 主应用地址
WEB_APP_URL=http://app.lvh.me:3100

# ---- 默认模型配置（可在 web 应用 settings 页覆盖，存数据库） ----
# OpenAI 兼容协议即可接入本地模型：Ollama -> http://localhost:11434/v1
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
